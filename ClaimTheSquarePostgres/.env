# Kopier til .env og fyll inn:  cp .env.example .env
# .env skal ALDRI i Git. .env.example ER i Git — den er kontrakten om hvilke
# variabler stacken trenger.

POSTGRES_DB=claimthesquare
POSTGRES_USER=claimuser
POSTGRES_PASSWORD=change-me

# ── Prod-sim (compose.prod.yml) ──────────────────────────────────────────
# API_IMAGE er navnet uten tag. IMAGE_TAG er hele deploy-knappen: å endre den
# er å bytte versjon. Begge fylles ut når du deployer et CI-bygget image.
API_IMAGE=ghcr.io/example/claimthesquare
IMAGE_TAG=sha-0000000

# Porten API-et publiseres på — BARE på 127.0.0.1. nginx på verten proxier til
# den. Sett en annen verdi per student hvis flere deler én server.
API_PORT=8080

# Deler du server med andre, gir du stacken ditt eget navnerom her. Da får
# containere, nettverk og volumer ikke navnekollisjon med naboens stack.
# COMPOSE_PROJECT_NAME=claimthesquare-dittnavn
